    public function antiTan(dx:int, dy:int):int {
        var MAX_VALUE:Number = (Number(JInteger.MAX_VALUE));
        var MIN_VALUE:Number = (Number(JInteger.MIN_VALUE));
        var ratio:Number = (MAX_VALUE - 1);
        if (dy != 0) {
            var dxl:Number = (Number(dx));
            ratio = Number(this.SCALE) * dxl / Number(dy);
            if (dx <= 0 && dy < 0) {
                ratio = this.mathUtil.abslong(ratio);
            }
        }
        if ((dx >= 0 && dy < 0)) {
            for (index = 180; index > 90; index--) {
                if (ratio <= this.noDecimalTan[index]) {
                    if (ratio > this.noDecimalTan[int(index - 1)]) {
                        return (((int(index) << 16) >> 16));
                    } else if (this.noDecimalTan[int(index - 1)] == MAX_VALUE && ratio > MIN_VALUE) {
                        return (((int(index) << 16) >> 16));
                    }
                }
            }
        } else if ((dx < 0 && dy <= 0)) {
            for (index = 270; index > 180; index--) {
                if (ratio < this.noDecimalTan[index] && ratio >= this.noDecimalTan[int(index - 1)]) {
                    return (((int(index) << 16) >> 16));
                }
            }
        } else if ((dx < 0 && dy > 0)) {
            for (index = (int(this.noDecimalTan.length - 1)); index > 270; index--) {
                if (ratio < this.noDecimalTan[index]) {
                    if (ratio >= this.noDecimalTan[int(index - 1)]) {
                        return (((int(index) << 16) >> 16));
                    } else if (this.noDecimalTan[int(index - 1)] == MAX_VALUE && ratio >= MIN_VALUE) {
                        return (((int(index) << 16) >> 16));
                    }
                }
            }
        } else if ((dx >= 0 && dy >= 0)) {
            for (var index:int = 90; index > 0; index--) {
                if (ratio < this.noDecimalTan[index] && ratio >= this.noDecimalTan[int(index - 1)]) {
                    return (((int(index) << 16) >> 16));
                }
            }
        }
        var stringBuffer:StringMaker = new StringMaker();
        stringBuffer.append("Invalid Ratio: ");
        stringBuffer.appendlong(ratio);
        stringBuffer.append(CommonSeps.getInstance().SPACE);
        stringBuffer.append(PositionStrings.getInstance().DX_LABEL);
        stringBuffer.appendint(dx);
        stringBuffer.append(CommonSeps.getInstance().SPACE);
        stringBuffer.append(PositionStrings.getInstance().DX_LABEL);
        stringBuffer.appendint(dy);
        throw new JException("Exception", stringBuffer.toString());
    }
    

    public function antiTanDebug(screenX:int, screenY:int, targetX:int, targetY:int):int {
        var METHOD_NAME:String = "antiTanDebug";
        var TARGET_ANGLE:String = " Targeting angle: ";
        var stringMaker:StringMaker = new StringMaker();
        PreLogUtil.put(stringMaker.append("screenX: ").appendint(screenX).append(" screenY: ").appendint(screenY).append(" targetX: ").appendint(targetX).append(" targetY: ").appendint(targetY).toString(), this, METHOD_NAME);
        var targetX2:int = -targetX;
        var targetY2:int = -targetY;
        var screenX2:int = -screenX;
        var screenY2:int = -screenY;
        var dx:Vector.<int> = new Vector.<int>(4);
        dx[0] = (int(screenX - targetX));
        dx[1] = (int(screenX - targetX2));
        dx[2] = (int(screenX2 - targetX));
        dx[3] = (int(screenX2 - targetX2));
        var dy:Vector.<int> = new Vector.<int>(4);
        dy[0] = (int(screenY - targetY));
        dy[1] = (int(screenY - targetY2));
        dy[2] = (int(screenY2 - targetY));
        dy[3] = (int(screenY2 - targetY2));
        var angleOfTarget:int = 0;
        var angleFactory:AngleFactory = AngleFactory.getInstance();
        var angle:Angle = null;
        for (var index:int = 0; index < dx.length; index++) {
            for (var index2:int = 0; index2 < dy.length; index2++) {
                angleOfTarget = this.antiTan(dx[index], dy[index2]);
                angle = angleFactory.getAt(angleOfTarget);
                stringMaker.delete_(0, stringMaker.length());
                PreLogUtil.put(stringMaker.append(CommonLabels.getInstance().INDEX_LABEL).appendint(index).append(" index2: ").appendint(index2).append(PositionStrings.getInstance().DX_LABEL).appendint(dx[index]).append(PositionStrings.getInstance().DY_LABEL).appendint(dy[index2]).append(TARGET_ANGLE).appendshort(angleOfTarget).append(CommonSeps.getInstance().EQUALS).appendshort(angle.getValue()).toString(), this, METHOD_NAME);
            }
        }
        angleOfTarget = this.antiTan(dx[0], dy[0]);
        return angleOfTarget;
    }
