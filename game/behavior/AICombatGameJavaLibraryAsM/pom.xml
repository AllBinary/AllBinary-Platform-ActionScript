                                <argument>${project.build.outputDirectory}/META-INF/as</argument>
                                <argument>${project.build.directory}/as-objects</argument>
                                <argument>${project.build.directory}/as-dependencies/META-INF/as</argument>
                                <argument>${planned.runtime.directory}</argument>
                                <argument>${planned.compiler}</argument>
                                <argument>${planned.compiler.flags}</argument>
                                <argument>${project.artifactId}</argument>
                                <argument>${planned.fail.on.error}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
